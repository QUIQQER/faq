                            <description>
                                <locale group="quiqqer/faq" var="quiqqer.faq.list2025.settings.btnAlignment.desc"/>
                            </description>
                            <option value="stretch">
                                <locale group="quiqqer/faq" var="quiqqer.faq.list2025.settings.btnAlignment.stretch"/>
                            </option>
                            <option value="left">
                                <locale group="quiqqer/faq" var="quiqqer.faq.list2025.settings.btnAlignment.left"/>
                            </option>
                            <option value="center">
                                <locale group="quiqqer/faq" var="quiqqer.faq.list2025.settings.btnAlignment.center"/>
                            </option>
                            <option value="right">
                                <locale group="quiqqer/faq" var="quiqqer.faq.list2025.settings.btnAlignment.right"/>
                            </option>
                        </select>

                        <select conf="quiqqer.faq.list2025.settings.subpages">
                            <text>
                                <locale group="quiqqer/faq" var="quiqqer.faq.list2025.settings.subpages"/>
                            </text>
                            <description>
                                <locale group="quiqqer/faq" var="quiqqer.faq.list2025.settings.subpages.desc"/>
                            </description>

                            <option></option>
                            <option value="">
                                <locale group="quiqqer/faq" var="quiqqer.faq.list2025.settings.subpages.disabled"/>
                            </option>
                            <option value="categories">
                                <locale group="quiqqer/faq" var="quiqqer.faq.list2025.settings.subpages.categories"/>
                            </option>
                            <option value="all">
                                <locale group="quiqqer/faq" var="quiqqer.faq.list2025.settings.subpages.all"/>
                            </option>
