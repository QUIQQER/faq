                <attribute default="default">quiqqer.faq.list2025.settings.template</attribute>
                <attribute default="1">quiqqer.faq.list2025.settings.showImage</attribute>
                <attribute>quiqqer.faq.list2025.settings.imageWidth</attribute>
                <attribute default="center">quiqqer.faq.list2025.settings.imageAlignment</attribute>
                <attribute default="1">quiqqer.faq.list2025.settings.showTitle</attribute>
                <attribute default="1">quiqqer.faq.list2025.settings.showDesc</attribute>
                <attribute default="left">quiqqer.faq.list2025.settings.textAlignment</attribute>
                <attribute default="1">quiqqer.faq.list2025.settings.showButton</attribute>
                <attribute default="stretch">quiqqer.faq.list2025.settings.btnAlignment</attribute>
                <attribute>quiqqer.faq.list2025.settings.btnCssClass</attribute>
                <attribute>quiqqer.faq.list2025.settings.subpages</attribute>
