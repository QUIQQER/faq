                        <input conf="quiqqer.faq.settings.offset" type="number">
                            <text>
                                <locale group="quiqqer/faq" var="quiqqer.faq.category.settings.offset"/>
                            </text>
                            <description>
                                <locale group="quiqqer/faq" var="quiqqer.faq.category.settings.offset.desc"/>
                            </description>
                        </input>
                    </settings>
                </category>
