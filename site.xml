                            </description>
                            <option value="left">
                                <locale group="quiqqer/faq" var="quiqqer.faq.list2025.settings.imageAlignment.left"/>
                            </option>
                            <option value="center">
                                <locale group="quiqqer/faq" var="quiqqer.faq.list2025.settings.imageAlignment.center"/>
                            </option>
                            <option value="right">
                                <locale group="quiqqer/faq" var="quiqqer.faq.list2025.settings.imageAlignment.right"/>
                            </option>
                        </select>

                        <input conf="quiqqer.faq.list2025.settings.showTitle" type="checkbox">
                            <text>
                                <locale group="quiqqer/faq" var="quiqqer.faq.list2025.settings.showTitle"/>
                            </text>
                            <description>
                                <locale group="quiqqer/faq" var="quiqqer.faq.list2025.settings.showTitle.desc"/>
                            </description>
